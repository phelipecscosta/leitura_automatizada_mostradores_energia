# Modelo de configuração local.
# Copie este arquivo para .env, na mesma pasta, e preencha os valores.
# O .env é ignorado pelo Git e nunca deve ser versionado.

# Pasta com os lotes originais de fotos.
# Regra do projeto: somente leitura. Nenhum código pode mover, renomear
# ou alterar arquivos dentro dela.
METER_READER_DATA_DIR=C:\caminho\para\a\base_de_dados

# Pasta de trabalho local, fora de qualquer repositório e fora da pasta de
# dados. Guarda artefatos derivados dos dados do cliente (manifesto, amostra
# de rotulagem, tabela de pseudônimos) e a chave secreta de pseudonimização.
# Inclua esta pasta inteira no backup: perder a chave desliga os rótulos das
# fotos, e a chave nunca é recriada automaticamente.
METER_READER_WORK_DIR=C:\caminho\para\a\pasta_de_trabalho

# Raiz "Imagens processadas" (spec 2.3). Recebe uma subpasta por lote, com as
# fotos movidas, a planilha de controle e a lista de cópias antigas. Fica fora
# de qualquer repositório e da pasta de dados. No cliente, é escolhida no
# instalador (ET9).
METER_READER_OUTPUT_DIR=C:\caminho\para\Imagens processadas

# Artefato da triagem (triagem_c4.pt). Em desenvolvimento, fica na pasta de
# trabalho; no cliente, é baixado dos Releases (E01, ET9).
METER_READER_TRIAGE_ARTIFACT=C:\caminho\para\a\pasta_de_trabalho\modelos\triagem5\triagem_c4.pt
