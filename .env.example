# Modelo de configuração local.
# Copie este arquivo para .env, na mesma pasta, e preencha os valores.
# O .env é ignorado pelo Git e nunca deve ser versionado.

# Pasta com os lotes originais de fotos.
# Regra do projeto: somente leitura. Nenhum código pode mover, renomear
# ou alterar arquivos dentro dela.
METER_READER_DATA_DIR=C:\caminho\para\a\base_de_dados

# Pasta de trabalho local, fora de qualquer repositório e fora da pasta de
# dados. Guarda artefatos derivados dos dados do cliente, como o manifesto.
METER_READER_WORK_DIR=C:\caminho\para\a\pasta_de_trabalho
